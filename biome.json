{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"app/**",
			"components/**",
			"lib/**",
			"convex/**",
			"worker/**",
			"tests/**",
			"scripts/**/*.mjs",
			"!convex/_generated",
			"!**/*.css"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"preset": "recommended",
				"useSemanticElements": "warn",
				"useMediaCaption": "warn"
			},
			"performance": {
				"noImgElement": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
